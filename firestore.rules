rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Student profile isolation
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Student-specific subcollections
      match /improveResults/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /applyResults/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /studyTasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /applications/{applicationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // University and Programme catalogues (public read-only reference data)
    match /universities/{universityId} {
      allow read: if isAuthenticated();
      allow write: if false; // System admin managed only
    }

    match /programmes/{programmeId} {
      allow read: if isAuthenticated();
      allow write: if false; // System admin managed only
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
